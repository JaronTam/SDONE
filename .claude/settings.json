{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; print(json.load(sys.stdin)['tool_input']['file_path'])\" | xargs -r npx prettier --write"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json; print(json.load(sys.stdin)['tool_input']['file_path'])\" | xargs -r npx prettier --write"
          }
        ]
      }
    ]
  }
}
